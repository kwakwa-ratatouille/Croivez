rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() { return request.auth != null; }
    function moi(uid) { return connecte() && request.auth.uid == uid; }

    // Profil privé : progression, révision, amis
    match /users/{uid} {
      allow read, write: if moi(uid);
    }
    // Profil public : pseudo, XP, niveau (classements, recherche d'amis)
    match /profils/{uid} {
      allow read: if connecte();
      allow write: if moi(uid);
    }
    // Pseudos uniques : on ne peut réserver qu'un pseudo libre, pour soi
    match /pseudos/{cle} {
      allow read: if connecte();
      allow create: if connecte() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if connecte() && resource.data.uid == request.auth.uid;
    }
    // Parrainages : le filleul se déclare, seul le parrain lit et marque son bonus comme récupéré
    match /parrainages/{filleul} {
      allow create: if moi(filleul) && request.resource.data.parrain != filleul && request.resource.data.reclame == false;
      allow read: if connecte() && resource.data.parrain == request.auth.uid;
      allow update: if connecte() && resource.data.parrain == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reclame']);
    }
    // Classement de la semaine
    match /semaines/{semaine}/scores/{uid} {
      allow read: if connecte();
      allow write: if moi(uid);
    }
  }
}
