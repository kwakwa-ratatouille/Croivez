rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque joueur ne lit et n'écrit que son propre profil (classements : à ouvrir à l'étape duels)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
